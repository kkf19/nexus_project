# Variables d'environnement du backend — jamais de vraie valeur commitée ici.
# Copier ce fichier en `.env` à la racine du dépôt et y mettre les vraies valeurs.

# Supabase -> Project Settings -> Database -> Connection string -> URI
DATABASE_URL=postgresql://postgres:VOTRE_MOT_DE_PASSE@db.xxxx.supabase.co:5432/postgres

# console.anthropic.com -> API Keys -> Create Key. Nécessaire à partir de la Phase 2 (pipeline IA).
ANTHROPIC_API_KEY=

# Modèle utilisé pour l'extraction (STRUCTURED) et le mapping taxonomie (STANDARDIZED)
ANTHROPIC_MODEL=claude-haiku-4-5

# Référentiel de taxonomie chargé au démarrage (dev-brief.md §2.1) — chemin relatif à la racine du dépôt
TAXONOMY_CONFIG_PATH=docs/technical/taxonomy.config.json
